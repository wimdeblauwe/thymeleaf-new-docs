---
import { Code } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import InstallSnippets from '../components/InstallSnippets.astro';
import { homeExample } from '../data/home-examples';
import project from '../data/project.json';
import { formatDate } from '../data/format';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const template = 'src/main/resources/templates/seedstarters/list.html';
const controller = 'src/main/java/org/thymeleaf/samples/showcase/seedstarter/SeedStarterController.java';
const strengths = [
	{
		title: 'Natural templates',
		text: 'Keep one HTML file for design and for production, and check a layout without starting the application.',
		path: 'docs/start/natural-templates/',
	},
	{
		title: 'Spring integration',
		text: 'Bind forms, show validation errors and reach your beans from templates, with Spring Boot autoconfiguration.',
		path: 'docs/spring/overview/',
	},
	{
		title: 'Extensible dialects',
		text: 'Add your own attributes and expression objects, or use a dialect that someone else has written.',
		path: 'docs/extending/why-extend-thymeleaf/',
	},
];
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: 'A modern server-side Java template engine',
		description: 'A modern server-side Java template engine for web and standalone environments.',
		template: 'splash',
		pagefind: false,
		hero: { title: 'Thymeleaf', actions: [] },
	}}
>
	<div class="home not-content">
		<section aria-labelledby="strengths">
			<h2 id="strengths">What it gives you</h2>
			<ul class="strengths">
				{
					strengths.map(({ title, text, path }) => (
						<li>
							<h3><a href={`${base}${path}`}>{title}</a></h3>
							<p>{text}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="split" aria-labelledby="install">
			<div>
				<h2 id="install">Add it to your project</h2>
				<p>
					With Spring Boot, add <code>spring-boot-starter-thymeleaf</code> and Boot picks the version.
					Without it, use the coordinates here.
				</p>
				<p>
					Thymeleaf {project.version} was released on {formatDate(project.releaseDate)}.{' '}
					<a href={`${base}download/`}>See all modules</a>
				</p>
			</div>
			<div class="snippets"><InstallSnippets artifactId="thymeleaf" /></div>
		</section>

		<section class="split" aria-labelledby="modern">
			<div>
				<h2 id="modern">Update part of a page without a reload</h2>
				<p>
					A controller can render one fragment of a template. With htmx, this search box asks for the{' '}
					<code>rows</code> fragment and swaps it into the page. The full page and the partial update
					share the same markup.
				</p>
				<p>
					<a href={`${base}docs/interactive-uis/overview/`}>Interactive UIs</a> shows the whole
					approach, and the <a href={`${base}ecosystem/`}>ecosystem</a> lists libraries that help.
				</p>
			</div>
			<div class="snippets">
				<Code code={homeExample(template)} lang="html" title="list.html" />
				<Code code={homeExample(controller).trim()} lang="java" title="SeedStarterController.java" />
			</div>
		</section>

		<section aria-labelledby="next">
			<h2 id="next">Find your way around</h2>
			<ul class="next">
				<li><a href={`${base}ecosystem/`}>Browse dialects, components and tools</a></li>
				<li><a href={`${base}community/`}>Get help, report issues or contribute</a></li>
			</ul>
		</section>
	</div>
</StarlightPage>

<style>
	.home {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 4rem;
		padding-block: 2rem;
	}
	h2 {
		margin-block-end: 1rem;
		font-family: var(--font-display);
		font-size: var(--sl-text-3xl);
		font-weight: 500;
		line-height: 1.2;
		text-wrap: balance;
	}
	h3 {
		margin-block-end: 0.375rem;
		font-family: var(--font-display);
		font-size: var(--sl-text-xl);
		font-weight: 500;
	}
	p {
		margin-block-end: 1rem;
		color: var(--sl-color-gray-2);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.strengths {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem 3rem;
	}
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
	}
	.split > div {
		min-width: 0;
	}
	.snippets {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
	}
	.next {
		display: grid;
		gap: 0.5rem;
	}
	@media (min-width: 50rem) {
		.strengths {
			grid-template-columns: repeat(3, 1fr);
		}
		.split {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
			gap: 3rem;
		}
	}
</style>
