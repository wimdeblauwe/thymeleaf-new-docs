---
const groups = Astro.locals.starlightRoute.sidebar.filter((entry) => entry.type === 'group');
---

<div class="all-docs not-content">
	{
		groups.map((group) => (
			<section>
				<h3>{group.label}</h3>
				<ul>
					{group.entries.map(
						(entry) =>
							entry.type === 'link' && (
								<li>
									<a href={entry.href}>{entry.label}</a>
								</li>
							),
					)}
				</ul>
			</section>
		))
	}
</div>

<style>
	.all-docs {
		columns: 15rem;
		column-gap: 2.5rem;
	}
	section {
		break-inside: avoid;
		padding-block-end: 1.5rem;
	}
	h3 {
		margin-block-end: 0.375rem;
		color: var(--sl-color-white);
		font-family: var(--font-display);
		font-size: var(--sl-text-lg);
		font-weight: 500;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding-block: 0.125rem;
	}
	a {
		font-size: var(--sl-text-sm);
	}
</style>
