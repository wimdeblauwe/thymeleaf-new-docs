---
import { Code } from '@astrojs/starlight/components';
import { homeExample } from '../data/home-examples';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const template = homeExample('Template');
const output = homeExample('Output');
---

<section class="home-hero not-content" aria-labelledby="home-title">
	<h1 id="home-title">A modern server-side Java template engine</h1>
	<p class="lead">
		For web and standalone environments. Thymeleaf templates are HTML, so the same file opens in a
		browser as a prototype and runs on the server as the real page.
	</p>
	<div class="actions">
		<a class="action primary" href={`${base}docs/start/quickstart-spring-boot/`}>Start with Spring Boot</a>
		<a class="action" href={`${base}docs/`}>Read the docs</a>
	</div>

	<div class="demo">
		<figure class="source">
			<figcaption>One template, <code>products.html</code></figcaption>
			<Code code={template} lang="html" mark={[/th:[a-z]+="[^"]*"/g]} ins={['Oranges', '0.99']} />
		</figure>
		<figure class="window prototype">
			<figcaption>Opened in a browser: <code>th:*</code> is ignored, placeholders show</figcaption>
			<!-- This is the template itself. The browser ignores its th:* attributes here too. -->
			<div class="result" set:html={template} />
		</figure>
		<figure class="window rendered">
			<figcaption>Run by Thymeleaf: values come from the model</figcaption>
			<div class="result" set:html={output} />
		</figure>
	</div>
</section>

<style>
	.home-hero {
		padding-block: 2rem 1rem;
	}
	h1 {
		max-width: 16em;
		margin: 0;
		color: var(--sl-color-text-accent);
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 7vw, 4.25rem);
		font-style: italic;
		font-weight: 400;
		line-height: 1.08;
		text-wrap: balance;
	}
	.lead {
		max-width: 38rem;
		margin-block: 1.25rem 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xl);
		line-height: 1.5;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block: 1.5rem 3rem;
	}
	.action {
		padding: 0.625rem 1.125rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: none;
	}
	.action:hover {
		border-color: var(--sl-color-gray-3);
	}
	.primary,
	.primary:hover {
		border-color: var(--sl-color-text-accent);
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
	}

	.demo {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
	}
	figure {
		min-width: 0;
		margin: 0;
	}
	figcaption {
		margin-block-end: 0.5rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	figcaption code {
		font-size: 0.95em;
	}
	.result {
		overflow-x: auto;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background: var(--sl-color-bg-nav);
	}
	.result :global(table) {
		width: 100%;
		border-collapse: collapse;
	}
	.result :global(th),
	.result :global(td) {
		padding: 0.25rem 0.5rem 0.25rem 0;
		border-bottom: 1px solid var(--sl-color-hairline);
		text-align: start;
	}
	.result :global(tr:last-child td) {
		border-bottom: 0;
	}
	.source :global(ins) {
		--ec-marker: var(--demo-placeholder);
		background: color-mix(in srgb, var(--demo-placeholder) 18%, transparent);
		outline: 1px solid var(--demo-placeholder);
		outline-offset: -1px;
	}
	.prototype :global(td) {
		color: var(--demo-placeholder);
		font-style: italic;
	}
	.rendered :global(td) {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}

	@media (min-width: 50rem) {
		.demo {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			grid-template-areas:
				'source prototype'
				'source rendered';
		}
		.source {
			grid-area: source;
		}
		.prototype {
			grid-area: prototype;
		}
		.rendered {
			grid-area: rendered;
		}
	}
</style>
